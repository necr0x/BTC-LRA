//@version=6
// BTC-LRA OI Events
// Generated by btc-lra-oi-control-monitor.py; copy into TradingView.
// Event timestamps use Panama time (UTC-5).
indicator("BTC-LRA OI Events", overlay=true, max_labels_count=500)
// Exported events: 2

show_market = input.bool(true, "Show MARKET events")
show_limit = input.bool(true, "Show LIMIT events")
show_unclear = input.bool(true, "Show UNCLEAR events")
show_details = input.bool(false, "Show detailed labels")

event_0_time = timestamp("GMT-5", 2026, 10, 1, 23, 20)
event_0_price = 86247.6000000000
event_0_shown = show_market
if event_0_shown and time <= event_0_time and time_close > event_0_time
    label.new(x=event_0_time, y=86247.6000000000 * 0.999, xloc=xloc.bar_time, yloc=yloc.price, text=show_details ? "TIME: 2026-10-01 23:20 Panama\\nPRICE: 86 247.6 USDT\\nOI ACT: 694.9 BTC\\nNET: -180.3 BTC\\nAGGR: BUY 69.3% +1 667.3 BTC\\nPRICE CHANGE: +372.3 USDT\\nCONTROL: MARKET BUY" : "M BUY", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)

event_1_time = timestamp("GMT-5", 2026, 10, 1, 23, 21)
event_1_price = 86300.0000000000
event_1_shown = show_unclear
if event_1_shown and time <= event_1_time and time_close > event_1_time
    label.new(x=event_1_time, y=86300.0000000000, xloc=xloc.bar_time, yloc=yloc.price, text=show_details ? "TIME: 2026-10-01 23:21 Panama\\nPRICE: 86 300 USDT\\nOI ACT: 328 BTC\\nNET: -105.3 BTC\\nAGGR: SELL 50.6% +20.5 BTC\\nPRICE CHANGE: +53 USDT\\nCONTROL: UNCLEAR" : "?", style=label.style_label_left, color=color.gray, textcolor=color.white, size=size.tiny)

